# Database Connection (Neon PostgreSQL or Local PostgreSQL)
# Required for: Running Prisma migrations, verify-connection check, and local operations
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-odd-thunder.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis Cache Configuration (Rate Limiting)
# Optional in: Local Development (falls back gracefully to Map-based in-memory locks)
# Required in: Production deployments (apps/web)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Canonical Site Configuration
# Optional in: Local Development (defaults to localhost:3000)
# Required in: Production (e.g. https://gpttopdf.site)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

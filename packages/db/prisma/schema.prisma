datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ExportEvent {
  id                 String   @id @default(uuid())
  timestamp          DateTime @default(now())
  success            Boolean
  failureReason      String?  // e.g. "Rate Limited", "Invalid URL", "Fetch Failed"
  failureStage       String?  // e.g. "rate_limiting", "fetch_chat_page", "generate_pdf"
  httpStatus         Int?     // HTTP status code returned to client
  pdfSize            Int?     // Size of the generated PDF in bytes
  chatSource         String?  // e.g. "chatgpt-shared"
  referrer           String   @default("Unknown")
  browser            String   @default("Unknown")
  operatingSystem    String   @default("Unknown")
  deviceType         String   @default("Unknown")
  country            String   @default("Unknown")
  city               String   @default("Unknown")
  generationDuration Float    // overall duration in seconds

  @@index([timestamp])
  @@index([success])
  @@index([browser])
  @@index([deviceType])
  @@index([referrer])
}

model DailyStatistic {
  date               DateTime @id // truncated date (e.g. 2026-06-30 00:00:00 UTC)
  totalExports       Int      @default(0)
  successes          Int      @default(0)
  failures           Int      @default(0)
  avgGenerationTime  Float    @default(0.0) // running average of success duration
}
